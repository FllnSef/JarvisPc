      "aliases": ["ви эс код", "вс код", "visual studio code"]
    },
    "chatgpt": {
      "name": "ChatGPT",
      "url": "https://chatgpt.com/",
      "aliases": ["чат джи пи ти", "чатгпт", "chatgpt"]
    },
    "happ": {
      "name": "Happ VPN",
      "path": "%ProgramFiles%\\FlyFrogLLC\\Happ\\Happ.exe",
      "args": [],
      "processes": ["Happ.exe"],
      "aliases": ["хапп", "хэпп", "happ", "впн"]
    },
    "telegram": {
      "name": "Telegram",
      "path": "%APPDATA%\\Telegram Desktop\\Telegram.exe",
