    },
    "steam": {
      "name": "Steam",
      "path": "%ProgramFiles(x86)%\\Steam\\steam.exe",
      "args": [],
      "processes": ["steam.exe"],
      "aliases": ["стим", "steam"]
    },
    "music": {
      "name": "Яндекс Музыка",
      "path": "%LOCALAPPDATA%\\Programs\\YandexMusic\\Яндекс Музыка.exe",
      "args": [],
