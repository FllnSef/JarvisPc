{
  "assistant": {
    "hotkey": "ctrl+alt+j",
    "exitHotkey": "ctrl+alt+q"
  },
  "voiceInput": {
    "modelPath": "models/vosk-model-small-ru-0.22",
    "device": null,
    "sampleRate": 16000,
    "timeoutSeconds": 10,
    "fallbackToKeyboard": true
  },
  "voiceOutput": {
    "preferredVoice": "Microsoft Pavel",
    "rate": 165,
    "volume": 1.0
  },
  "browser": "%ProgramFiles%\\Yandex\\YandexBrowser\\Application\\browser.exe",
